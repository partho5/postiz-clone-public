# 8 GB VPS. Optionally moves Temporal visibility to Elasticsearch:
#   set TEMPORAL_ENABLE_ES=true and start with --profile es.
# Switching visibility stores does not migrate old visibility rows; running
# workflows keep working, only history search of closed runs starts fresh.

APP_MEM_LIMIT=2500m
BACKEND_HEAP_MB=1024
ORCHESTRATOR_HEAP_MB=768
FRONTEND_HEAP_MB=512
PRISMA_CONNECTION_LIMIT=15

PG_MEM_LIMIT=1800m
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_MAX_CONNECTIONS=200

TEMPORAL_MEM_LIMIT=1000m
TEMPORAL_GOMEMLIMIT=850MiB
# History shards are fixed at cluster creation. Never change on an existing DB.
TEMPORAL_HISTORY_SHARDS=4
TEMPORAL_SQL_MAX_CONNS=20
TEMPORAL_ENABLE_ES=false

REDIS_MEM_LIMIT=384m
REDIS_MAXMEMORY=256mb

CADDY_MEM_LIMIT=128m

ES_HEAP=1g
ES_MEM_LIMIT=1600m
