# 4 GB VPS. Same services, more headroom. Swap still recommended (2 GB).
# Measured 2026-10-08: with 1400m the app container reached its ceiling while both Nest apps
# started and used swap; 1800m leaves room (about 770 MB of the app is pnpm, dotenv and pm2 wrappers).

APP_MEM_LIMIT=1800m
BACKEND_HEAP_MB=512
ORCHESTRATOR_HEAP_MB=384
FRONTEND_HEAP_MB=384
PRISMA_CONNECTION_LIMIT=10

PG_MEM_LIMIT=900m
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=64MB
PG_MAX_CONNECTIONS=150

TEMPORAL_MEM_LIMIT=600m
TEMPORAL_GOMEMLIMIT=500MiB
# History shards are fixed at cluster creation. Never change on an existing DB.
TEMPORAL_HISTORY_SHARDS=4
TEMPORAL_SQL_MAX_CONNS=10
TEMPORAL_ENABLE_ES=false

REDIS_MEM_LIMIT=192m
REDIS_MAXMEMORY=128mb

CADDY_MEM_LIMIT=128m

ES_HEAP=256m
ES_MEM_LIMIT=512m
