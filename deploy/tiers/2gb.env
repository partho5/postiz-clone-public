# 2 GB VPS. Requires 2 GB of swap on the host (deploy/scripts/setup-swap.sh).
# Secrets and host values come from deploy/.env, loaded after this file.
#
# Measured 2026-10-08 on the CI-built image (docker, cgroup v2, no swap available to the app), after
# sign-in traffic through Caddy; MB:
#   backend    V8 heap crashes at 384 and survives 448   -> cap 576 (about 1.3x the working need)
#   orchestrator V8 heap crashes at 256 and survives 320 -> cap 416 (about 1.3x)
#   frontend   survives 192 (next-server RSS 105)         -> cap 192
#   app container, resident (anon): 1200 once running, peak 1500 while both Nest apps start
#     together; 1200 limit OOM-kills in a loop, 1500 does not. About 770 of it is pnpm, dotenv and
#     pm2 wrapper processes, not the apps.
#   postgres 47 resident (peak 301 with cache), temporal 145 (peak 350 with cache), redis 4, caddy 10.
# All resident figures together are about 1.4 GB; the limits below are ceilings, not reservations,
# and add up to more than 2 GB on purpose. The 2 GB of host swap takes the start-up peak.

APP_MEM_LIMIT=1500m
BACKEND_HEAP_MB=576
ORCHESTRATOR_HEAP_MB=416
FRONTEND_HEAP_MB=192
PRISMA_CONNECTION_LIMIT=5

PG_MEM_LIMIT=400m
PG_SHARED_BUFFERS=128MB
PG_EFFECTIVE_CACHE_SIZE=384MB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=32MB
PG_MAX_CONNECTIONS=100

TEMPORAL_MEM_LIMIT=350m
TEMPORAL_GOMEMLIMIT=280MiB
TEMPORAL_HISTORY_SHARDS=4
TEMPORAL_SQL_MAX_CONNS=5
TEMPORAL_ENABLE_ES=false

REDIS_MEM_LIMIT=96m
REDIS_MAXMEMORY=64mb

CADDY_MEM_LIMIT=64m

ES_HEAP=256m
ES_MEM_LIMIT=512m
