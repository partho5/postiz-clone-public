# Production environment. Copy to deploy/.env, fill every value marked  <-- FILL, and never commit it.
# deploy/scripts/deploy.sh <tier> loads this file after deploy/tiers/<tier>.env, and the app container reads
# it too, so this one file is the only thing the operator edits. Values are read literally: keep a value that
# contains a $ in single quotes. Passwords go into database URLs, so use URL-safe ones: openssl rand -hex 24
#
# Only host-specific values and credentials differ from a development .env; everything else below is the
# same as in development (00_invariants.md, "Production parity").

# ============================================================================================================
# 1. Host-specific
# ============================================================================================================
DOMAIN=app.example.com                                   # <-- FILL  public name; DNS A record -> this VPS
FRONTEND_URL=https://app.example.com                     # <-- FILL  exactly https://$DOMAIN
NEXT_PUBLIC_BACKEND_URL=https://app.example.com/api      # <-- FILL  https://$DOMAIN/api; also the phone app's base URL
# Image the CI built (.github/workflows/build-image.yml tags: latest, v*, short sha). Pin a tag to roll back.
APP_IMAGE=ghcr.io/partho5/postiz-clone-public:latest
# Edge. Unset: Caddy owns ports 80/443 and gets the certificate itself. HOST_NGINX=1: this server already runs nginx for
# other sites, so Caddy stays off, the app listens on 127.0.0.1:APP_HOST_PORT (deploy/host-nginx.yaml) and the host nginx
# proxies the domain to it (site template deploy/nginx/site.conf, TLS by certbot).
HOST_NGINX=
APP_HOST_PORT=3000
# DATABASE_URL, DATABASE_WORKER_URL, REDIS_URL, TEMPORAL_ADDRESS and BACKEND_INTERNAL_URL are built by
# deploy/docker-compose.yaml from the values in section 2; do not set them here.

# ============================================================================================================
# 2. Credentials
# ============================================================================================================
# Postgres worker role: owns the tables, runs migrations and the orchestrator, bypasses row-level security.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me                              # <-- FILL
POSTGRES_DB=app
# Postgres API role for the backend (row-level security on the money tables); created by migrate.sh.
APP_DB_USER=app_api
APP_DB_PASSWORD=change-me                                # <-- FILL  different from the line above
# Temporal's own role. It must NOT be called "temporal" or "temporal_visibility": those are Temporal's
# database names and a role of that name stops it creating them.
TEMPORAL_DB_USER=temporal_app
TEMPORAL_DB_PASSWORD=change-me                           # <-- FILL

JWT_SECRET=change-me                                     # <-- FILL  long random: openssl rand -hex 48
APP_CREDENTIALS_SECRET=change-me                         # <-- FILL  openssl rand -hex 32; encrypts each workspace's social app keys. Changing it = every workspace re-enters its keys

# Paid features: the backend signs the offline plan token (ES256) that the phone app checks with the public key.
# The backend refuses to start in production without it. Make the key once (the commands are in deploy/DEPLOY_GUIDE.md,
# "paid-features signing key"): the private key goes here on ONE line, in single quotes, its line breaks written as \n; the matching
# public key (kid=base64) goes into the app's ENTITLEMENT_PUBLIC_KEYS. A new key later gets a new ENTITLEMENT_KEY_ID.
ENTITLEMENT_SIGNING_KEY=change-me                        # <-- FILL  '-----BEGIN PRIVATE KEY-----\nMIG...\n-----END PRIVATE KEY-----\n'
ENTITLEMENT_KEY_ID=change-me                             # <-- FILL  any short name, e.g. k1

# PayPal REST app (billing), from developer.paypal.com > Apps & Credentials (Sandbox or Live toggle).
# PAYPAL_MODE picks the API: live -> https://api-m.paypal.com, sandbox -> https://api-m.sandbox.paypal.com.
# The client id, secret and webhook id must come from an app of that same mode.
# PAYPAL_API_BASE stays empty; set it only to override the URL PAYPAL_MODE picks.
PAYPAL_MODE=live                                         # live or sandbox
PAYPAL_API_BASE=
PAYPAL_CLIENT_ID=change-me                               # <-- FILL
PAYPAL_CLIENT_SECRET=change-me                           # <-- FILL
PAYPAL_WEBHOOK_ID=change-me                              # <-- FILL  webhook URL: https://$DOMAIN/api/payment/paypal

# Sign-in codes are mailed through Mailgun's HTTP API (EMAIL_PROVIDER=log is refused when NODE_ENV=production).
EMAIL_PROVIDER=mailgun
MAILGUN_API_KEY=change-me                                # <-- FILL  private API key
MAILGUN_DOMAIN=mg.example.com                            # <-- FILL  the verified sending domain
MAILGUN_REGION=us                                        # us or eu
EMAIL_FROM_NAME=Nany Social
EMAIL_FROM_ADDRESS=noreply@example.com                   # <-- FILL  an address on the Mailgun domain

# Media storage (Cloudflare R2): uploads never stream through the Node processes on the small box.
STORAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=change-me                          # <-- FILL
CLOUDFLARE_ACCESS_KEY=change-me                          # <-- FILL
CLOUDFLARE_SECRET_ACCESS_KEY=change-me                   # <-- FILL
CLOUDFLARE_BUCKETNAME=change-me                          # <-- FILL
CLOUDFLARE_BUCKET_URL=https://cdn.change-me.com/change-me   # <-- FILL  public media host, no trailing slash (the only place it is defined)
RESTRICT_UPLOAD_DOMAINS=cdn.change-me.com                # <-- FILL  must name the same host as CLOUDFLARE_BUCKET_URL
CLOUDFLARE_REGION=auto
MEDIA_RETENTION_DAYS=1                                   # days after a phone upload's last posted URL it is purged; -1 forever, 0 right after
MEDIA_RETENTION_ERROR_DAYS=7                             # days a file is kept when a channel ended in ERROR (Retry), then purged
MEDIA_SWEEP_DELETE=false                                # nightly orphan/soft-deleted sweeps: false = dry run (log only); set true after reading the dry-run logs

# AI provider keys: add the ones you use, names as in the repo .env.example. Channel OAuth app keys
# (X_API_KEY, FACEBOOK_APP_ID, LINKEDIN_CLIENT_ID, ...) are NOT set here: each workspace enters its own on
# Settings > App credentials (T4), and a provider whose keys a workspace has not entered is unavailable to it.
OPENAI_API_KEY=
# AI captions from a recording's speech (paid plans): the speech is transcribed by ElevenLabs Speech-to-Text (Scribe v2),
# the captions are written with OPENAI_API_KEY (the line above). Get ELEVEN_LABS_API_KEY from the ElevenLabs dashboard
# (https://elevenlabs.io). It is a key of the whole deployment, not a workspace credential. An empty key is not an error:
# the feature answers 503 AI_CAPTIONS_NOT_CONFIGURED and nothing else changes.
ELEVEN_LABS_API_KEY=
# Legacy / alternative transcriber: Meta Muse Transcribe (https://dev.meta.ai; Muse Transcribe docs: https://dev.meta.ai/docs/speech-to-text).
# The same key also runs the content planner (Meta Model API chat, https://dev.meta.ai/docs/protocols/chat-completions); an empty key
# makes the planner answer 503 PLAN_NOT_AVAILABLE and nothing else changes.
META_MUSE_API_KEY=
# Only when Meta does not serve this server's region (the model list is empty and chat answers 404 model_not_found): the base URL of a
# relay in a served region (deploy/meta-relay, e.g. https://<project>.vercel.app/v1) and its token. Planner chat only; empty = Meta direct.
META_MUSE_BASE_URL=
META_MUSE_RELAY_TOKEN=
AI_CAPTIONS_MAX_AUDIO_BYTES=125829120                    # largest speech audio (a 16 kHz mono WAV) a phone may upload for captions: 120 MiB, over an hour
# AI edit perception (Standard, Heavy): Cloudflare Workers AI Clef-omni reads the proxy pieces of a recording; the account
# is CLOUDFLARE_ACCOUNT_ID above, the token needs the Workers AI permission. Empty is not an error: those edits are planned
# from the speech and the event log alone.
CLOUDFLARE_AI_TOKEN=
# AI edit decisions (the writer, the icon picker, the director): THE SWITCH is the model of all of them: muse-spark-1.3-contributor
# (META_MUSE_API_KEY), claude-haiku-5-5, claude-sonnet-5-5 (ANTHROPIC_API_KEY) or gpt-5-nano (OPENAI_API_KEY). Empty is
# muse-spark-1.3-contributor, and claude-haiku-5-5 when META_MUSE_API_KEY is empty. A model set here without its key is refused with 503.
AI_EDIT_DECISION_MODEL=
# AI edit writer (Heavy): the model that writes the on-screen texts; empty is AI_EDIT_DECISION_MODEL. A failed call only
# means the plan is made without written texts.
AI_EDIT_WRITER_MODEL=
# AI edit icon picker: the model that picks an icon or clip per slot from the names found; empty is AI_EDIT_WRITER_MODEL, then
# AI_EDIT_DECISION_MODEL. A failed call only means those slots have no icon.
AI_EDIT_ICON_MODEL=
# AI edit director: the model that labels each sentence (hook, claim, ...) and picks the video's style; empty is
# AI_EDIT_DECISION_MODEL. A failed call only means the plan is made without a director.
AI_EDIT_DIRECTOR_MODEL=
# AI edit assets: icons and mp4 clips from IconScout (free preview files; the Client-ID stays on the server; empty ID = no icons).
# Files are cached in R2 for all workspaces.
ICONSCOUT_CLIENT_ID=
# Days a cached icon or mp4 file may go unused before the daily purge deletes it (a whole number from 1 to 36500; empty or anything else = 30).
AI_EDIT_ASSET_RETENTION_DAYS=
# Where the CC0 sound effects are served: <base>/<id>.wav (pop_1, pop_2, whoosh_short, swoosh, ding, impact_soft, click). Empty = no sounds.
AI_EDIT_SOUNDS_BASE_URL=
# AI edit tracing: what the server keeps of every step and decision of an edit job (table AiVideoEditTrace). off = nothing,
# meta = counts, codes, sizes and hashes (the default; also empty or anything else), full = the whole redacted JSON incl. transcript
# words and plan texts (test servers only; read by super-admins only). API keys, auth headers and signed-URL queries are removed in every mode.
AI_EDIT_TRACE=
# Largest payload of one trace row in bytes (a whole number of 1 or more; empty = 524288); a bigger one is stored as its size and sha256.
AI_EDIT_TRACE_MAX_BYTES=
# Days a trace row is kept before the daily purge deletes it (a whole number from 1 to 36500; empty or anything else = 365).
AI_EDIT_TRACE_DAYS=
# AI edit client check: 1 = a plan the phone cannot draw (an unknown effect, look, zone or asset, an item with no time range) ends the job
# as FAILED with its credits released; empty or anything else (the default) = such findings are only traced and kept in the edit's log, and the job is delivered.
AI_EDIT_CLIENT_CHECK_BLOCK=

# ============================================================================================================
# 3. Tier and behaviour (same as development; do not change per host)
# ============================================================================================================
# Memory knobs (APP_MEM_LIMIT, *_HEAP_MB, PG_*, TEMPORAL_*, REDIS_*, CADDY_MEM_LIMIT, PRISMA_CONNECTION_LIMIT)
# come from deploy/tiers/<tier>.env, chosen by the argument to deploy.sh. Do not set them here: this file is
# loaded last and would override the tier.
NODE_ENV=production
RUN_CRON=true                                            # periodic workflows (reconciliation, cleanups) run
IS_GENERAL=true
# Sign-in and session limits; these are the defaults, shown so a change is deliberate.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=36500
REFRESH_GRACE_SECONDS=60
AUTH_FAIL_LIMIT=10
AUTH_FAIL_WINDOW_SECONDS=900
OTP_TTL_SECONDS=600
OTP_MAX_TRIES=5
OTP_REQUEST_LIMIT=5
OTP_REQUEST_WINDOW_SECONDS=900
OTP_RESEND_COOLDOWN_SECONDS=30
MAIL_SEND_TIMEOUT_SECONDS=10
