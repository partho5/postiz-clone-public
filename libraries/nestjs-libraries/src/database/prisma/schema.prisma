// A workspace's mobile auto-publish choices (one row per workspace). setId: the Set the app publishes
// every finished recording with, and timing (`now` or `next_slot`); null = automatic mode (every
// eligible channel with default settings). excludedIntegrations: channel ids auto-publish skips, in
// both modes. textIntegrations: ids of text-only channels (a provider that takes no video) the owner switched on to
// get a text post written from the recording's speech (ai.video-captions); off unless listed. A new table, so
// `Organization` and `Sets` gain no column.
model AutoPublishPreset {
  id                   String   @id @default(uuid())
  organizationId       String   @unique
  setId                String?  @unique
  set                  Sets?    @relation(fields: [setId], references: [id], onDelete: SetNull)
  timing               String   @default("now")
  excludedIntegrations String[] @default([])
  textIntegrations     String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// A phone's direct-to-R2 multipart upload (api.mobile-direct-upload). The row is the ownership
// record: every route loads it by id AND organizationId. status: pending | completing | completed |
// aborted | expired (a String, as Media.status). mediaId is set on complete; no foreign key, as a
// Media row is soft-deleted. purpose: media (a video or image for a post, the default) | transcript_audio (speech
// audio for ai.video-captions: it makes no Media row and is deleted once transcribed) | edit_proxy (a small .mp4 of a
// recording for ai.video-editing: no Media row either, closed after a day). Written only by the mobile-upload repository.
model MobileUpload {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  objectKey      String
  uploadId       String
  filename       String
  size           BigInt
  partSize       Int
  partCount      Int
  status         String       @default("pending")
  mediaId        String?
  purpose        String       @default("media")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  expiresAt      DateTime

  @@index([organizationId, status])
  @@index([status, createdAt])
}

