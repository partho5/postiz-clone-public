// A social app credential of a workspace (T4), under the same name as the old .env key
// (X_API_KEY, FACEBOOK_APP_SECRET, ...). `value` is AES-256-GCM ciphertext bound to the
// workspace and key (app.credentials.encryption.ts); never read from .env as a fallback.
model AppCredential {
  id             String       @id @default(uuid())
