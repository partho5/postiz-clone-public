generator client {
  provider = "prisma-client-js"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                  String               @id @default(uuid())
  name                String
  description         String?
  apiKey              String?
  paymentId           String?
  streakSince         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  allowTrial          Boolean              @default(false)
  isTrailing          Boolean              @default(false)
  shortlink           ShortLinkPreference  @default(ASK)
  autoPost            AutoPost[]
  Comments            Comments[]
  credits             Credits[]
  clippings           Clipping[]
  customers           Customer[]
  errors              Errors[]
  github              GitHub[]
  Integration         Integration[]
  media               Media[]
  buyerOrganization   MessagesGroup[]
  notifications       Notifications[]
  plugs               Plugs[]
  post                Post[]               @relation("organization")
  submittedPost       Post[]               @relation("submittedForOrg")
  sets                Sets[]
  signatures          Signatures[]
  subscription        Subscription?
  tags                Tags[]
  thirdParty          ThirdParty[]
  appCredentials      AppCredential[]
  usedCodes           UsedCodes[]
  users               UserOrganization[]
  webhooks            Webhooks[]
  oauthApp            OAuthApp[]
  oauthAuthorizations OAuthAuthorization[]
  accountId           String?
  account             Account?             @relation(fields: [accountId], references: [id])
  creditLedger        CreditLedger[]
  apiKeys             ApiKey[]
  mobileUploads       MobileUpload[]
  aiCaptions          AiCaption[]
  aiVideoEdits        AiVideoEdit[]
  promptOverrides     PromptOverride[]
  contentPlan         ContentPlan?
  planDays            PlanDay[]
  planInstantIdeas    PlanInstantIdea[]
  planSessions        PlanSession[]
  slug                String?
  color               String?
  avatarUrl           String?
  timezone            String?
  locale              String?
  profile             Json?

  @@unique([accountId, slug])
  @@index([profile], type: Gin)
  @@index([apiKey])
  @@index([accountId])
  @@index([streakSince])
  @@index([paymentId])
  @@index([deletedAt])
}

model Tags {
  id           String       @id @default(uuid())
  name         String
  color        String
  orgId        String
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id])
  posts        TagsPosts[]

  @@index([orgId])
  @@index([deletedAt])
}

model TagsPosts {
  postId    String
  tagId     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id])
  tag       Tags     @relation(fields: [tagId], references: [id])

  @@id([postId, tagId])
  @@unique([postId, tagId])
}

model User {
  id                    String               @id @default(uuid())
  email                 String
  password              String?
  providerName          Provider
  name                  String?
  lastName              String?
  isSuperAdmin          Boolean              @default(false)
  bio                   String?
  audience              Int                  @default(0)
  pictureId             String?
  providerId            String?
  timezone              Int
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  lastReadNotifications DateTime             @default(now())
  inviteId              String?
  activated             Boolean              @default(true)
  account               String?
  connectedAccount      Boolean              @default(false)
  lastOnline            DateTime             @default(now())
  ip                    String?
  agent                 String?
  deletedAt             DateTime?
  comments              Comments[]
  items                 ItemUser[]
  groupBuyer            MessagesGroup[]      @relation("groupBuyer")
  groupSeller           MessagesGroup[]      @relation("groupSeller")
  orderBuyer            Orders[]             @relation("orderBuyer")
  orderSeller           Orders[]             @relation("orderSeller")
  payoutProblems        PayoutProblems[]
  agencies              SocialMediaAgency?
  picture               Media?               @relation(fields: [pictureId], references: [id])
  organizations         UserOrganization[]
  sendSuccessEmails     Boolean              @default(true)
  sendFailureEmails     Boolean              @default(true)
  sendStreakEmails      Boolean              @default(true)
  oauthAuthorizations   OAuthAuthorization[]
  ownedAccount          Account?             @relation("accountOwner")
  deviceSessions        DeviceSession[]
  activityLogs          ActivityLog[]
  trackerDevices        TrackerDevice[]
  trackerActivities     TrackerActivity[]

  @@unique([email, providerName])
  @@index([lastReadNotifications])
  @@index([inviteId])
  @@index([account])
  @@index([lastOnline])
  @@index([pictureId])
  @@index([deletedAt])
}

model UsedCodes {
  id           String       @id @default(uuid())
  code         String
  orgId        String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id])

  @@index([code])
}

model UserOrganization {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  disabled       Boolean      @default(false)
  role           Role         @default(USER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([userId, organizationId])
  @@index([disabled])
}

model GitHub {
  id             String       @id @default(uuid())
  login          String?
  name           String?
  token          String
  jobId          String?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([login])
  @@index([organizationId])
}

model Trending {
  id           String   @id @default(uuid())
  trendingList String
  language     String?  @unique
  hash         String
  date         DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([hash])
}

model TrendingLog {
  id       String   @id @default(uuid())
  language String?
  date     DateTime
}

model ItemUser {
  id     String @id @default(uuid())
  userId String
  key    String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, key])
  @@index([userId])
  @@index([key])
}

model Star {
  id         String   @id @default(uuid())
  stars      Int
  totalStars Int
  forks      Int
  totalForks Int
  login      String
  date       DateTime @default(now()) @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([login, date])
}

model Media {
  id                 String              @id @default(uuid())
  name               String
  originalName       String?
  path               String
  organizationId     String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  fileSize           Int                 @default(0)
  type               String              @default("image")
  thumbnail          String?
  alt                String?
  thumbnailTimestamp Int?
  status             String              @default("ready")
  processingError    String?
  // api.media-retention: 'mobile' for a file the phone uploaded straight to R2 (the only rows the
  // retention purge may touch); NULL for every other row. purgedAt is set when the R2 object was
  // removed; the row itself stays (id, path, thumbnail).
  origin             String?
  purgedAt           DateTime?
  // api.media-retention (RET-B4): object key of the small poster image the phone sent with `complete`.
  // Not `thumbnail` (that is the user's chosen video cover, sent to the platforms). Survives the video
  // purge; the web preview shows it for a purged video. NULL when no poster was sent.
  posterKey          String?
  organization       Organization        @relation(fields: [organizationId], references: [id])
  agencies           SocialMediaAgency[]
  userPicture        User[]
  oauthApps          OAuthApp[]

  @@index([name])
  @@index([posterKey])
  @@index([organizationId])
  @@index([type])
  @@index([origin, purgedAt])
}

model SocialMediaAgency {
  id               String                   @id @default(uuid())
  userId           String                   @unique
  name             String
  logoId           String?
  website          String?
  slug             String?
  facebook         String?
  instagram        String?
  twitter          String?
  linkedIn         String?
  youtube          String?
  tiktok           String?
  otherSocialMedia String?
  shortDescription String
  description      String
  approved         Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  deletedAt        DateTime?
  logo             Media?                   @relation(fields: [logoId], references: [id])
  user             User                     @relation(fields: [userId], references: [id])
  niches           SocialMediaAgencyNiche[]

  @@index([userId])
  @@index([deletedAt])
  @@index([id])
}

model SocialMediaAgencyNiche {
  agencyId String
  niche    String
  agency   SocialMediaAgency @relation(fields: [agencyId], references: [id])

  @@id([agencyId, niche])
}

model Credits {
  id             String       @id @default(uuid())
  organizationId String
  credits        Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  type           String       @default("ai_images")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([createdAt])
}

model Clipping {
  id             String         @id @default(uuid())
  organizationId String
  url            String
  status         String         @default("analysing")
  error          String?
  title          String?
  thumbnail      String?
  duration       Int?
  maxClips       Int            @default(5)
  fit            String         @default("blur")
  integrations   String
  creditsId      String?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id])
  clips          ClippingClip[]

  @@index([organizationId])
  @@index([deletedAt])
}

model ClippingClip {
  id         String    @id @default(uuid())
  clippingId String
  title      String
  content    String
  start      Float
  end        Float
  trimStart  Int?
  status     String    @default("pending")
  error      String?
  mediaId    String?
  path       String?
  thumbnail  String?
  draftedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  clipping   Clipping  @relation(fields: [clippingId], references: [id])

  @@index([clippingId])
}

// A caption job for one recorded video (ai.video-captions): the speech audio the phone uploaded, its transcript,
// and the text written for each channel (AiCaptionOutput). audioUploadId is the MobileUpload id of that audio, with no
// foreign key (as MobileUpload.mediaId); one audio makes one caption. mode: auto | manual. status: PENDING | TRANSCRIBING |
// GENERATING | READY | NO_SPEECH | FAILED (a String, as Clipping.status). userText is the plain caption typed on a manual
// publish, integrationIds the channels the captions are written for, audioSeconds the length read from the audio's own
// header (what the charge is worked out from). A transcript is plain text; segments are its timed pieces.
// creditState: SETTLED (no hold waits: the default, and every job that ended without a held caption) | HELD (READY,
// its credits held until the phone uses the caption) | COMMITTED (used) | RELEASED (thrown away unused) | INCLUDED
// (an AI edit that reuses the transcript took it over). Soft-deleted from the web page.
model AiCaption {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  audioUploadId  String            @unique
  mode           String
  title          String?
  userText       String?
  integrationIds String[]
  status         String            @default("PENDING")
  error          String?
  transcript     String?
  segments       Json?
  language       String?
  audioSeconds   Int?
  creditState    String            @default("SETTLED")
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  outputs        AiCaptionOutput[]

  @@index([organizationId, createdAt])
  @@index([deletedAt])
}

// The text written for one channel of a caption job. kind: video | text (a text post, for a channel that takes no
// video). promptKey, promptVersion, promptSource (default | workspace) and model say which prompt and model wrote it.
// postId and postGroup are set once a post is created from it; they name no foreign key, as a post is soft-deleted.
model AiCaptionOutput {
  id                 String    @id @default(uuid())
  captionId          String
  caption            AiCaption @relation(fields: [captionId], references: [id], onDelete: Cascade)
  integrationId      String
  providerIdentifier String
  kind               String
  title              String?
  text               String
  hashtags           String[]
  promptKey          String
  promptVersion      Int
  promptSource       String
  model              String
  postId             String?
  postGroup          String?
  createdAt          DateTime  @default(now())

  @@index([captionId])
}

// An AI edit job for one recording (ai.video-editing): the server plans the edit as JSON and the phone renders it.
// sessionId is the phone's recording session uuid; one job per recording and level, so a repeated tap answers the
// same job. level: basic | standard | heavy. status: PENDING | TRANSCRIBING | PLANNING | READY | NO_SPEECH | FAILED
// (a String, as AiCaption.status). The words come from a READY caption (aiCaptionId) or a transcript_audio upload
// (audioUploadId); proxyUploadIds are the edit_proxy uploads (Standard, Heavy). None of these is a foreign key, as
// MobileUpload.mediaId. request is the phone's request body, plan and assets what it renders, log the planner's
// warnings and rejections. sourceSeconds is the length charged for, cost the credits reserved.
model AiVideoEdit {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  sessionId      String
  level          String
  status         String       @default("PENDING")
  error          String?
  aiCaptionId    String?
  audioUploadId  String?
  proxyUploadIds String[]
  request        Json
  words          Json?
  scores         Json?
  texts          Json?
  plan           Json?
  assets         Json?
  // the exact body `GET /public/v1/ai-edits/:id` serves once READY, built once (tracing card L4)
  delivered      Json?
  log            Json?
  language       String?
  sourceSeconds  Int
  cost           Int
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  traces         AiVideoEditTrace[]

  @@unique([organizationId, sessionId, level])
  @@index([organizationId, createdAt])
}

// One step or decision of an AI edit job, append only (ai.video-editing, tracing). `seq` counts the rows of one edit
// from 1 and is unique with the edit, so two writers never share a number. `kind` is `input` | `output` | `decision` |
// `error` | `metric`; `payload` is the JSON the trace mode allows (redacted, size capped), `payloadBytes` and
// `payloadSha256` describe the full redacted JSON in every mode. Rows go with their edit and after
// AI_EDIT_TRACE_DAYS days.
model AiVideoEditTrace {
  id             String      @id @default(uuid())
  editId         String
  edit           AiVideoEdit @relation(fields: [editId], references: [id], onDelete: Cascade)
  organizationId String
  seq            Int
  step           String
  kind           String
  attempt        Int?
  durationMs     Int?
  ok             Boolean?
  payload        Json
  payloadBytes   Int
  payloadSha256  String
  createdAt      DateTime    @default(now())

  @@unique([editId, seq])
  @@index([createdAt])
}

// An icon or mp4 clip file of a stock provider (ai.video-editing), downloaded once into R2 and shared by every
// workspace: the file is not a customer's, so the row has no organizationId. The plan's asset url is the object's
// public url. `kind` is `video` | `icon` | `sound`; the columns after `height` are what the provider said about the
// file (name, slug, price, colours, the rest in `meta`), the query that found it, where it came from (`source`, e.g.
// `preview`) and when it was last used, which the retention job reads.
model AiEditAsset {
  id               String    @id @default(uuid())
  provider         String
  providerId       String
  kind             String
  objectKey        String
  nativeDurationMs Int?
  width            Int?
  height           Int?
  name             String?
  slug             String?
  price            Int?
  query            String?
  colorCodes       Json?
  meta             Json?
  source           String?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@unique([provider, providerId])
  @@index([lastUsedAt])
}

// A default prompt of the Prompt Book (ai.video-captions): the instruction text every workspace starts with, a locked
// frame, or the model for a prompt key. A change is a new row with the next version of its key; the highest version
// is the live one and the others are the history the owner can restore. Seeded at start-up (insert only).
model PromptDefault {
  id          String   @id @default(uuid())
  key         String
  version     Int
  body        String
  model       String?
  settings    Json?
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([key, version])
}

// A workspace's own version of a Prompt Book prompt (ai.video-captions). A save is a new row with the next version of
// its key for that workspace; the highest is the one used. Deleted with the workspace.
model PromptOverride {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  version        Int
  body           String
  createdById    String?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, key, version])
}

// A brand's content plan: the confirmed direction the AI plans every week from. One per workspace. status: SETUP |
// PROPOSED | ACTIVE. busy names the job that is running (round | proposal | replan); notice is a one-time message for
// the owner. proposalTurns is the proposal/revise chat exactly as sent, so the next call re-sends it byte for byte.
model ContentPlan {
  id               String            @id @default(uuid())
  organizationId   String            @unique
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status           String            @default("SETUP")
  sourceText       String?           @db.Text
  direction        String?           @db.Text
  directionVersion Int               @default(0)
  videosPerWeek    Int               @default(3)
  facts            Json?
  proposal         Json?
  proposalVersion  Int               @default(0)
  proposalTurns    Json?
  busy             String?
  notice           String?
  confirmedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  rounds           ContentPlanRound[]
  themes           PlanTheme[]
  clusters         PlanCluster[]
  weeks            PlanWeek[]
  instantIdeas     PlanInstantIdea[]
  sessions         PlanSession[]
}

// One question round of a plan's setup: what the AI understood and what it asked. userTurn and assistantTurn are the
// exact texts of the chat, stored so the next round re-sends them byte for byte.
model ContentPlanRound {
  id            String      @id @default(uuid())
  planId        String
  plan          ContentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  index         Int
  direction     String      @db.Text
  questions     Json
  answers       Json?
  readyForPlan  Boolean     @default(false)
  userTurn      String      @db.Text
  assistantTurn String      @db.Text
  createdAt     DateTime    @default(now())

  @@unique([planId, index])
}

// One run of the planning engine's interview -> proposal -> confirm procedure for a kind of work (a set of videos, a
// future feature). kind names the PlanSessionKind that writes and confirms it. status: ASKING | PROPOSING | PROPOSED |
// DONE | DISCARDED. busy names the job that holds the session (round | proposal | confirm); notice is a one-time message
// for the owner. summary is what the AI understood (the owner may edit it); options are the kind's start options.
// proposalTurns is the proposal/revise chat exactly as sent, so the next call re-sends it byte for byte.
model PlanSession {
  id              String             @id @default(uuid())
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId          String
  plan            ContentPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  kind            String
  status          String             @default("ASKING")
  sourceText      String?            @db.Text
  summary         String?            @db.Text
  options         Json?
  proposal        Json?
  proposalVersion Int                @default(0)
  proposalTurns   Json?
  busy            String?
  notice          String?
  confirmedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  rounds          PlanSessionRound[]
  instantIdeas    PlanInstantIdea[]

  @@index([organizationId, kind, status])
  @@index([planId])
}

// One question round of a session: what the AI understood and what it asked. userTurn and assistantTurn are the exact
// texts of the chat, stored so the next round re-sends them byte for byte.
model PlanSessionRound {
  id            String      @id @default(uuid())
  sessionId     String
  session       PlanSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  index         Int
  summary       String      @db.Text
  questions     Json
  answers       Json?
  readyForPlan  Boolean     @default(false)
  userTurn      String      @db.Text
  assistantTurn String      @db.Text
  createdAt     DateTime    @default(now())

  @@unique([sessionId, index])
}

// A long-term theme (pillar) of a plan.
model PlanTheme {
  id          String        @id @default(uuid())
  planId      String
  plan        ContentPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  name        String
  description String?       @db.Text
  position    Int
  archivedAt  DateTime?
  clusters    PlanCluster[]
}

// One customer problem or question under a theme; a week covers one cluster. rotationIndex is the order the weeks
// walk through the clusters.
model PlanCluster {
  id            String      @id @default(uuid())
  planId        String
  plan          ContentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  themeId       String
  theme         PlanTheme   @relation(fields: [themeId], references: [id], onDelete: Cascade)
  title         String
  problem       String      @db.Text
  rotationIndex Int
  archivedAt    DateTime?
  weeks         PlanWeek[]

  @@index([planId, rotationIndex])
}

// One week of a plan: its idea, its brief and, once generated, its videos (`videosPerWeek` days). weekStart is the
// brand-local date (YYYY-MM-DD) of its first day. status: IDEA | GENERATING | READY | FAILED.
model PlanWeek {
  id          String      @id @default(uuid())
  planId      String
  plan        ContentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  clusterId   String
  cluster     PlanCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  weekStart   String
  idea        String      @db.Text
  ideaEdited  Boolean     @default(false)
  outline     Json?
  brief       String?     @db.Text
  briefEdited Boolean     @default(false)
  urgentNote  String?     @db.Text
  carryIn     Json?
  status      String      @default("IDEA")
  attempts    Int         @default(0)
  generatedAt DateTime?
  version     Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  days        PlanDay[]

  @@unique([planId, weekStart])
  @@index([planId, status])
}

// An owner's own video, dated by the owner. Not a day slot: no dayIndex, no effect on PlanDay or on the AI roadmap.
// status: DRAFT (not shown to the phone) | PLANNED | RECORDED | MISSED. sessionId is the planning session (a set of
// videos) that made it; null for a one-shot instant idea.
model PlanInstantIdea {
  id             String       @id @default(uuid())
  planId         String
  plan           ContentPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessionId      String?
  session        PlanSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  date           String
  idea           String       @db.Text
  title          String
  why            String       @db.Text
  beats          Json
  closingLine    String       @db.Text
  status         String       @default("DRAFT")
  recordedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, date])
  @@index([sessionId])
}

// One day of a week: the video to record that day. dayIndex is 0-6 within the week; beats are { hook, say } pairs.
// status: PLANNED | RECORDED | MISSED.
model PlanDay {
  id             String       @id @default(uuid())
  weekId         String
  week           PlanWeek     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dayIndex       Int
  date           String
  title          String
  angle          String
  why            String       @db.Text
  beats          Json
  closingLine    String       @db.Text
  status         String       @default("PLANNED")
  busy           Boolean      @default(false)
  recordedAt     DateTime?
  version        Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([weekId, dayIndex])
  @@index([organizationId, date])
}

model Subscription {
  id               String           @id @default(cuid())
  organizationId   String           @unique
  subscriptionTier SubscriptionTier
  provider         String           @default("stripe")
  identifier       String?
  cancelAt         DateTime?
  period           Period
  totalChannels    Int
