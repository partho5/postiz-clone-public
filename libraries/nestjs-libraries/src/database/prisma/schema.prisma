  createdAt   DateTime          @default(now())
}

// The paying customer. Owns one credit balance and many workspaces
// (organizations). A user owns at most one account and can be a member of
// workspaces that belong to other accounts.
model Account {
  id            String         @id @default(uuid())
  ownerId       String         @unique
  owner         User           @relation("accountOwner", fields: [ownerId], references: [id])
  planKey       String         @default("FREE")
  // Bumped at the start of every credit transaction. The UPDATE holds the
  // row lock until commit, so balance changes of one account never overlap.
  lockVersion   Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  organizations Organization[]
  creditBuckets CreditBucket[]
  creditLedger  CreditLedger[]
  creditEntries CreditEntry[]
}

// Registry of every billable action. cost 0 means free but still logged.
model CreditAction {
  key           String               @id
  cost          Int
  unit          CreditUnit           @default(CALL)
  version       Int                  @default(1)
  description   String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  planOverrides CreditPlanOverride[]
}

model CreditPlanOverride {
  id        String       @id @default(uuid())
  planKey   String
  actionKey String
  cost      Int
  action    CreditAction @relation(fields: [actionKey], references: [key])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([planKey, actionKey])
}

// A period-scoped pricing value (free monthly grant, free AI cap) and the UTC
// month it applies from. Written only by the pricing sync.
model CreditSetting {
  key           String
  value         Int
  effectiveFrom DateTime

  @@id([key, effectiveFrom])
}

// The next occurrence of a repeating post and, when its credits could not be
// reserved, since when it is flagged. Written only by recurring charging.
model RecurringCharge {
  postId     String    @id
  occurrence Int
  dueAt      DateTime
  flaggedAt  DateTime?
}

// A payment provider's webhook event, kept by the provider's event id so it is
// acted on once. Written only by the PayPal webhook intake.
model PaymentEvent {
  id          String    @id
  provider    String
  eventType   String
  resourceId  String?
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)

  @@index([eventType, resourceId])
}

// The paid plan an account holds through a payment provider, one per account,
// mirrored from the provider's own state. Written only by the PayPal subscriptions service.
model BillingSubscription {
  id                String    @id @default(uuid())
  accountId         String    @unique
  provider          String
  externalId        String    @unique
  tierKey           String
  status            String
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// The PayPal product and monthly plan created for a pricing-file tier in one PayPal
// environment (sandbox and live ids mean nothing in the other). Written only by the PayPal
// subscriptions service; plan ids are never configured by hand.
model PaypalPlan {
  id          String   @id @default(uuid())
  tierKey     String
  // The PayPal API host the plan was created on; null for plans stored before it was recorded.
  environment String?
  productId   String
  planId      String   @unique
  priceCents  Int
  currency    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tierKey, environment])
}

// A credit pack an account owner buys once with PayPal. The pack's credits and price are
// snapshotted when the order is created. Written only by the PayPal top-ups service.
model TopupOrder {
  id            String    @id @default(uuid())
  accountId     String
  userId        String
  paypalOrderId String    @unique
  captureId     String?   @unique
  packKey       String
  credits       Int
  priceCents    Int
  currency      String
  status        String
  grantedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([accountId])
}

// A signed-in device: its current refresh token is kept only as a hash,
// and the one before it for the grace window after a rotation.
model DeviceSession {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String?
  userAgent           String?
  ip                  String?
  refreshHash         String
  previousRefreshHash String?
  rotatedAt           DateTime?
  refreshExpiresAt    DateTime
  createdAt           DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())
  revokedAt           DateTime?

  @@index([userId, revokedAt])
}

// One batch of user-action events uploaded by the mobile app (api.activity-log). `userId` is null until the
// device's user signs in: the first signed-in batch of a `deviceId` claims that device's anonymous rows.
// `log` is the array of events as sent, after sanitising; `batchId` makes a retried upload a no-op.
model ActivityLog {
  id           String   @id @default(uuid())
  batchId      String   @unique
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String
  appVersion   String?
  device       String?
  eventCount   Int
  firstEventAt DateTime
  lastEventAt  DateTime
  log          Json
  receivedAt   DateTime @default(now())

  @@index([userId, firstEventAt])
  @@index([deviceId, firstEventAt])
  @@index([receivedAt])
}

// Activity tracker (api.activity-tracker): one phone install. `userId`/`email` are set once a batch arrives with a valid token.
model TrackerDevice {
  deviceId      String    @id
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  email         String?
  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  appVersion    String?
  appBuild      Int?
  os            String?
  sdk           Int?
  manufacturer  String?
  model         String?
  locale        String?
  activityCount Int       @default(0)
  errorCount    Int       @default(0)

  @@index([userId])
  @@index([lastSeenAt])
  @@index([email])
}

// Activity tracker (api.activity-tracker): one app session of one device (new after 30 min in background).
model TrackerSession {
  key           String   @id            // `${deviceId}:${session}`
  deviceId      String
  userId        String?
  session       String
  startedAt     DateTime
  endedAt       DateTime
  entrySource   String?                 // source of the session's app_open / app_foreground
  firstScreen   String?
  lastScreen    String?                 // where the session ended: drop-off
  activityCount Int      @default(0)
  errorCount    Int      @default(0)
  appBuild      Int?

  @@index([deviceId, startedAt])
  @@index([userId, startedAt])
  @@index([startedAt])
}

// Activity tracker (api.activity-tracker): one activity or error the app recorded.
model TrackerActivity {
  id           String    @id                   // uuid made by the phone
  deviceId     String
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionKey   String
  seq          Int
  kind         String                          // activity | error
  name         String
  description  String?
  startedAt    DateTime
  endedAt      DateTime?
  durationMs   Int?
  tz           Int       @default(0)
  appBuild     Int?
  screen       String?
  source       String?
  meta         Json?
  errorType    String?
  errorMessage String?
  errorStack   String?
  errorCauses  Json?
  errorThread  String?
  fatal        Boolean?
  lastActivity String?
  receivedAt   DateTime  @default(now())

  @@index([deviceId, startedAt])
  @@index([sessionKey, seq])
  @@index([userId, startedAt])
  @@index([name, description])
  @@index([kind, startedAt])
  @@index([startedAt])
  @@index([receivedAt])
}

// A key for the public API, MCP and enterprise endpoints: it works in one workspace and
// for its scopes only. Only a SHA-256 hash of the secret is kept (of the whole stored value, for a
// key migrated from `Organization.apiKey`); the key is shown once, when it is created.
model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  prefix         String       @unique
  secretHash     String
  scopes         String[]
  createdBy      String?
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  @@index([organizationId, revokedAt])
  @@index([secretHash])
}

// A mutation answered under an `Idempotency-Key`, kept so a retry gets the first answer. A
// RUNNING row holds the key while the handler runs; a DONE row with no responseBody is a
// streaming answer that cannot be replayed. Written only by the idempotency service.
model IdempotencyRecord {
  id              String           @id @default(uuid())
  principal       String
  workspaceId     String
  key             String
  fingerprint     String
  state           IdempotencyState
  statusCode      Int?
  responseBody    Bytes?
  responseHeaders Json?
  expiresAt       DateTime
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([principal, workspaceId, key])
  @@index([expiresAt])
}

enum IdempotencyState {
  RUNNING
  DONE
}

// A one-time sign-in code sent to an email address (api.email-otp). codeHash is a keyed hash, never
// the code; consumedAt is set when the code is used, replaced by a newer one, or never sent. Rows
// older than 24 hours are deleted on each request. Written only by the email-otp repository.
model EmailOtp {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  tries      Int       @default(0)
  consumedAt DateTime?
  requestIp  String
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([requestIp, createdAt])
  @@index([createdAt])
}

// A pot of credits. remaining is a cache of sum(entries.delta), checked by
// the reconciliation job. Spending takes the earliest expiring bucket first.
model CreditBucket {
  id        String           @id @default(uuid())
  accountId String
  account   Account          @relation(fields: [accountId], references: [id])
  type      CreditBucketType
  initial   Int
  remaining Int
  expiresAt DateTime?
  // Makes a grant idempotent, e.g. "paypal:event:<id>" or "starter:<account>"
  grantKey  String?          @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  entries   CreditEntry[]

  @@index([accountId, expiresAt])
}

// One billable action. Append-only apart from the status moving
// RESERVED -> COMMITTED or RESERVED -> RELEASED.
model CreditLedger {
  id             String             @id @default(uuid())
  accountId      String
  account        Account            @relation(fields: [accountId], references: [id])
  organizationId String?
  organization   Organization?      @relation(fields: [organizationId], references: [id])
  userId         String?
  actionKey      String
  actionVersion  Int
  quantity       Int
  // Price snapshot: registry changes never touch past or reserved charges
  unitCost       Int
  reserved       Int
  committed      Int?
  status         CreditLedgerStatus
  idempotencyKey String             @unique
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  entries        CreditEntry[]

  @@index([accountId, createdAt])
  @@index([organizationId, createdAt])
  @@index([status])
}

// Every movement of credits in or out of a bucket. Grants are positive,
// reservations negative, releases positive. sum(delta) per bucket must equal
// bucket.remaining.
model CreditEntry {
  id        String          @id @default(uuid())
  accountId String
  account   Account         @relation(fields: [accountId], references: [id])
  bucketId  String
  bucket    CreditBucket    @relation(fields: [bucketId], references: [id])
  ledgerId  String?
  ledger    CreditLedger?   @relation(fields: [ledgerId], references: [id])
  kind      CreditEntryKind
  delta     Int
  createdAt DateTime        @default(now())

  @@index([accountId])
  @@index([bucketId])
  @@index([ledgerId])
}

enum CreditUnit {
  CALL
  ITEM
  SECOND
}

enum CreditBucketType {
  GRANT
  TOPUP
  PROMO
  REFUND
  REVERSAL
}

enum CreditLedgerStatus {
  RESERVED
  COMMITTED
  RELEASED
}

enum CreditEntryKind {
  GRANT
  RESERVE
  RELEASE
  ADJUST
}
