# Copy this file to .env and fill in the values below.

# === Required Settings
## Two database roles (row-level security on the credit tables):
## DATABASE_URL is the API role (backend, commands); DATABASE_WORKER_URL is the
## role that owns the tables and bypasses RLS (orchestrator, migrations).
## Create the API role once, and after new migrations, with:
##   DATABASE_WORKER_URL=... APP_DB_USER=... APP_DB_PASSWORD=... \
##     sh libraries/nestjs-libraries/src/database/prisma/credits/scope/money-roles.sh
DATABASE_URL="postgresql://postiz-api:postiz-api-password@localhost:5432/postiz-db-local"
DATABASE_WORKER_URL="postgresql://postiz-user:postiz-password@localhost:5432/postiz-db-local"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="random string for your JWT secret, make it long"
# Encrypts the social app credentials each workspace enters on Settings > App credentials
# (AES-256-GCM). Required, at least 32 characters: openssl rand -hex 32. Changing it makes every
# saved credential unreadable (each workspace must enter its keys again); keep it apart from JWT_SECRET.
APP_CREDENTIALS_SECRET=""
# Paid features: the key that signs the plan token the phone app checks offline (ES256, P-256). Optional in
# development (GET /entitlements answers 503 without it); required when NODE_ENV=production. Make one with
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256
# and put the PEM on one line with its line breaks written as \n. The ready-made commands are in deploy/DEPLOY_GUIDE.md ("paid-features signing key").
# ENTITLEMENT_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ENTITLEMENT_KEY_ID="k1"
# Sessions: access token lifetime, refresh token sliding lifetime, the window in which a refresh
# token whose reply was lost may be presented again, and the failed-attempt limit per client address
# (sign-in, refresh, API key) before a 429. The refresh lifetime (about 100 years) is also the life of
# the web session cookies; each refresh sets them again. These are the defaults; leave them out to keep them.
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=36500
# REFRESH_GRACE_SECONDS=60
# AUTH_FAIL_LIMIT=10
# AUTH_FAIL_WINDOW_SECONDS=900

# === This needs to be exactly the URL you're accessing the app on
FRONTEND_URL="http://localhost:4200"
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"
BACKEND_INTERNAL_URL="http://localhost:3000"

## Remember to set your public internet IP address in the allow-list for the API token.
##
## Cloudflare is currently required to save things like social media avatars for accounts.
CLOUDFLARE_ACCOUNT_ID="your-account-id"
CLOUDFLARE_ACCESS_KEY="your-access-key"
CLOUDFLARE_SECRET_ACCESS_KEY="your-secret-access-key"
CLOUDFLARE_BUCKETNAME="your-bucket-name"
## The public media base URL, no trailing slash: the only place the media host is defined. Every stored media URL is
## this value plus the file name, and the social platforms fetch media from it, so it must be a public https custom
## domain on the bucket (not the r2.cloudflarestorage.com endpoint) with no bot challenge, hotlink protection or redirect.
CLOUDFLARE_BUCKET_URL="https://cdn.your-domain.com/your-bucket-path"
## Optional: the host every post media URL must contain; it must name the same host as CLOUDFLARE_BUCKET_URL.
#RESTRICT_UPLOAD_DOMAINS="cdn.your-domain.com"
CLOUDFLARE_REGION="auto"
## Mobile direct upload (POST /public/v1/upload/multipart): the largest file a phone may upload straight to R2, in bytes.
## Default 4294967296 (4 GiB); parts are a fixed 16 MiB, at most 10000 parts. Creating an upload also counts against
## API_LIMIT, in its own per-workspace "upload" bucket. In the Cloudflare dashboard add a lifecycle rule "Abort incomplete
## multipart uploads after 1 day" on the bucket: it is the backstop if the hourly sweep of abandoned uploads ever fails.
#MOBILE_UPLOAD_MAX_BYTES=4294967296
## Media retention (api.media-retention): the purge of the video files a phone uploaded straight to R2 (files from the web
## library are never auto-purged). A file is purged this many days after every channel of its post returned a posted URL:
## -1 keeps it forever (also switches the purge off), 0 purges right after the last URL, N waits N days. Default 1.
#MEDIA_RETENTION_DAYS=1
## Days a file is kept once a channel ended in ERROR (so Retry works), then purged; a file still used by a queued or draft
## post is never purged. 0 or more, default 7. A value that is not a whole number falls back to the default.
#MEDIA_RETENTION_ERROR_DAYS=7
## Nightly media sweeps (soft-deleted files nothing needs, and R2 objects no media row names). A DRY RUN unless this is exactly
## `true`: they only log what they would delete. Verify the dry-run logs ("Media orphan sweep (dry run)") before enabling.
## MEDIA_RETENTION_DAYS=-1 switches both sweeps off. Needs STORAGE_PROVIDER="cloudflare".
#MEDIA_SWEEP_DELETE=false
## Optional media normalization (media service on RunPod Serverless). Requires STORAGE_PROVIDER="cloudflare".
## When set, web uploads are transcoded to 1080p h264 mp4 / downsized images in the background;
## the media record reports status "processing" until the normalized file replaces the original.
#RUNPOD_API_KEY=""
#RUNPOD_ENDPOINT_ID=""
## Optional video clipping (YouTube video -> captioned vertical clips -> draft posts). Requires STORAGE_PROVIDER="cloudflare",
## RUNPOD_API_KEY (with access to both endpoints below) and OPENAI_API_KEY. Ingest jobs go to the CPU endpoint, clip jobs to the
## GPU endpoint of the media service (which needs its own Oxylabs account to fetch from YouTube); Deepgram transcribes videos
## that have no usable captions.
#RUNPOD_INGEST_ENDPOINT_ID=""
#RUNPOD_CLIPPER_ENDPOINT_ID=""
#DEEPGRAM_API_KEY=""
## Optional AI captions from a recording's speech (paid plans). The speech is transcribed by ElevenLabs Speech-to-Text (Scribe v2,
## an app-level key, not a workspace credential) and the captions are written with OPENAI_API_KEY. Requires STORAGE_PROVIDER="cloudflare".
## With the key empty or unset the feature answers 503 AI_CAPTIONS_NOT_CONFIGURED and nothing else changes; the app still starts.
#ELEVEN_LABS_API_KEY=""
## Legacy / alternative transcriber: Meta Muse Transcribe.
## The same key also runs the content planner (Meta Model API chat); with it empty or unset the planner answers 503 PLAN_NOT_AVAILABLE.
#META_MUSE_API_KEY=""
## The largest speech audio (a 16 kHz mono WAV) a phone may upload for captions, in bytes. Default 125829120 (120 MiB, over an hour).
#AI_CAPTIONS_MAX_AUDIO_BYTES=125829120
## The largest proxy video (a small .mp4 of a recording) a phone may upload for an AI edit, in bytes. Default 16777216 (16 MiB).
#AI_EDIT_MAX_PROXY_BYTES=16777216
## The longest recording an AI edit takes, in seconds; a longer one answers 400 VIDEO_TOO_LONG. Default 600 (10 minutes).
#AI_EDIT_MAX_SECONDS=600
## Perception for AI edits at Standard and Heavy: Cloudflare Workers AI (Clef-omni) reads the proxy pieces of a recording.
## An API token with the Workers AI permission; the account is CLOUDFLARE_ACCOUNT_ID above. Empty or unset: those edits are planned
## from the speech and the event log alone, nothing else changes.
#CLOUDFLARE_AI_TOKEN=""
## The model that writes the on-screen texts of a Heavy AI edit: claude-haiku-5-5 (ANTHROPIC_API_KEY, high effort) or gpt-5-nano (OPENAI_API_KEY, low effort).
## Unset: claude-haiku-5-5. Without the key of the chosen model a Heavy edit is refused with 503 AI_EDIT_NOT_CONFIGURED.
## A failed or unusable answer only means the plan is made without written texts.
#AI_EDIT_WRITER_MODEL=""
## The model that picks the icon or clip for a slot from the names IconScout found (one call per edit). Same choices as AI_EDIT_WRITER_MODEL.
## Unset: AI_EDIT_WRITER_MODEL, then claude-haiku-5-5. Without the key of the chosen model an edit with icons is refused with 503 AI_EDIT_NOT_CONFIGURED.
## A failed or unusable answer only means those slots have no icon.
#AI_EDIT_ICON_MODEL=""
## Icons and mp4 clips of AI edits (IconScout API v3, free preview files; the Client-ID stays on the server). Without ICONSCOUT_CLIENT_ID the plans have no icons.
## Every file downloaded is cached in R2 and reused for all workspaces.
#ICONSCOUT_CLIENT_ID=""
## Days a cached icon or mp4 file may go unused before the daily purge deletes it from R2 and the database. A whole number from 1 to 36500; unset or anything else: 30.
#AI_EDIT_ASSET_RETENTION_DAYS=30
## Where the CC0 sound effects of AI edits are served: <base>/<id>.wav for pop_1, pop_2, whoosh_short, swoosh, ding, impact_soft,
## click. Unset: the plans have no sounds.
#AI_EDIT_SOUNDS_BASE_URL=""

# === Common optional Settings

## This is a dummy key, you must create your own from Resend.
#RESEND_API_KEY=""
#EMAIL_FROM_ADDRESS=""
#EMAIL_FROM_NAME=""

## Sign-in codes are sent by EMAIL_PROVIDER: mailgun in production, log for local runs only
## (log writes the message, code included, to the server log and is refused when NODE_ENV=production).
#EMAIL_PROVIDER="mailgun"
#MAILGUN_API_KEY=""
#MAILGUN_DOMAIN=""
## us (default) or eu; MAILGUN_API_BASE replaces the host the region gives.
#MAILGUN_REGION="us"
#MAILGUN_API_BASE=""
## Seconds a required send (sign-in code) waits for the provider.
#MAIL_SEND_TIMEOUT_SECONDS=10
## Sign-in codes: life of a code, wrong values before it dies, codes asked per email address and per
## client address within the counting window (seconds).
#OTP_TTL_SECONDS=600
#OTP_MAX_TRIES=5
#OTP_REQUEST_LIMIT=5
#OTP_REQUEST_WINDOW_SECONDS=900
## Seconds before the same address may ask for another code (0 = no wait; at most the counting window).
#OTP_RESEND_COOLDOWN_SECONDS=30
#DISABLE_REGISTRATION=false

# Where will social media icons be saved - local or cloudflare.
STORAGE_PROVIDER="local"

# Your upload directory path if you host your files locally, otherwise Cloudflare will be used.
#UPLOAD_DIRECTORY=""

# Your upload directory path if you host your files locally, otherwise Cloudflare will be used.
#NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=""

# Sign in with Apple (login provider)
